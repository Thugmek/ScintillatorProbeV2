{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32H753 (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/stm32h753zi-debug/firmware",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "device": "STM32H753ZI",
            "svdFile": "",
            "runToEntryPoint": "main",
            "preLaunchTask": "Build Debug",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "searchSize": 16,
                "searchId": "SEGGER RTT",
                "clearSearch": true,
                "polling_interval": 10,
                "decoders": [
                    {
                        "label": "Logging",
                        "port": 0,
                        "noprompt": true,
                        "type": "console"
                    }
                ]
            }
        },
        {
            "name": "Attach STM32H753 (OpenOCD)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/stm32h753zi-debug/firmware",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "device": "STM32H753ZI",
            "svdFile": ""
        }
    ]
}
